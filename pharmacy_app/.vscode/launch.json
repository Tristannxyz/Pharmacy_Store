{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run PharmaCare Pro",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "MPLCONFIGDIR": "${env:TEMP}"
            }
        },
        {
            "name": "Setup Database (first time only)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/database/setup_db.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Train ML Models",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ml/train.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}

